{
  "display_information": {
    "name": "spacegrep",
    "description": "Visual inventory locator for hackerspaces and electronics labs",
    "background_color": "#0b0f17"
  },
  "features": {
    "bot_user": {
      "display_name": "spacegrep",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "chat:write",
        "files:read",
        "reactions:write",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels"
      ]
    },
    "socket_mode_enabled": true
  }
}
